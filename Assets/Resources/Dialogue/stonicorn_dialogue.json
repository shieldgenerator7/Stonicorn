      ],
      "quotes": [
        {
          "characterName": "Grunhardt",
          "text": "Oh, another one!",
          "imageFileName": "",
          "voiceLineFileName": ""
        },
        {
          "characterName": "Grunhardt",
          "text": "Do you happen to remember anything about being turned to stone?",
          "imageFileName": "",
          "voiceLineFileName": ""
        },
        {
          "characterName": "Grunhardt",
          "text": "Probably not.",
          "imageFileName": "",
          "voiceLineFileName": ""
        },
        {
          "characterName": "Grunhardt",
          "text": "But I hear there's a cure.",
          "imageFileName": "",
          "voiceLineFileName": ""
        },
        {
          "characterName": "Grunhardt",
          "text": "If you can find a way to the moon, the moonicorn might be able to help you.",
          "imageFileName": "",
          "voiceLineFileName": ""
        },
        {
          "characterName": "Grunhardt",
          "text": "I myself have tried but have gotten stuck here.",
          "imageFileName": "",
          "voiceLineFileName": ""
        },
        {
          "characterName": "Grunhardt",
          "text": "The lady unicorn to the east has gotten farther than me.",
          "imageFileName": "",
          "voiceLineFileName": ""
        },
        {
          "characterName": "Grunhardt",
          "text": "Maybe she can help you.",
          "imageFileName": "",
          "voiceLineFileName": ""
        },
        {
          "characterName": "Grunhardt",
          "text": "Would you, perhaps, say hi to her for me?",
          "imageFileName": "",
          "voiceLineFileName": ""
        }
      ],
      "actions": [
