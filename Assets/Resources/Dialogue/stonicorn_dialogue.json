        {
          "characterName": "Moonicorn",
          "text": "Oh I see you found it already!",
          "imageFileName": "",
          "voiceLineFileName": ""
        },
        {
          "characterName": "Moonicorn",
          "text": "Yeah I don't know if it still works, but it's worth a try.",
